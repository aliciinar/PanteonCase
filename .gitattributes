# Normalise text to LF in the repository; each machine checks out with its own line endings.
* text=auto

# Unity YAML (ForceText serialization) — always LF so diffs stay stable across Windows and macOS.
*.unity    text eol=lf
*.prefab   text eol=lf
*.asset    text eol=lf
*.meta     text eol=lf
*.mat      text eol=lf
*.anim     text eol=lf
*.controller text eol=lf
*.asmdef   text eol=lf
*.inputactions text eol=lf

# Binaries — never touched by line-ending conversion or textual diff.
*.png  binary
*.jpg  binary
*.jpeg binary
*.psd  binary
*.pdf  binary
*.dll  binary
*.so   binary
*.exe  binary
*.ttf  binary
*.otf  binary
*.wav  binary
*.mp3  binary
*.ogg  binary
*.fbx  binary
